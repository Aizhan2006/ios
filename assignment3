@discardableResult
func transferOxygen(from source: inout Int,
                    to target: inout Int,
                    amount: Int) -> Int {

    if amount < 0 {
        return 0
    }

    var transfer = amount

    if transfer > source {
        transfer = source
    }

    if target + transfer > 100 {
        transfer = 100 - target
    }

    source -= transfer
    target += transfer

    return transfer
}


