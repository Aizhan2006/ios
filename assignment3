// Old reportOxygen can crash when module or oxygenTank is nil.

func reportOxygen(for member: CrewMember) -> String {
    guard let oxygen = oxygenLevel(of: member) else {
        return "\(member.name): no data"
    }

    return "\(member.name): \(oxygen)%"
}


// Old firstCritical can crash because of !.
// It also finds the last critical member instead of the first one.

func firstCritical(in crew: [CrewMember]) -> String? {
    for member in crew {
        if let oxygen = oxygenLevel(of: member) {
            if oxygen < 20 {
                return member.name
            }
        }
    }

    return nil
}

